{
  "name": "AgriIntel 06 - Weekly intelligence report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "7 8 * * 1"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "dbc022ba-52ba-5dc1-8a80-2cf1efbc4df0"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGRIINTEL_API_URL }}/automation/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"kind\": \"weekly_report\", \"params\": {}, \"idempotency_key\": \"weekly-{{ $now.setZone('Asia/Colombo').toFormat('kkkk-WW') }}\", \"wait\": true}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Run AgriIntel job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "agriintel-automation-key",
          "name": "AgriIntel automation key (X-Automation-Key)"
        }
      },
      "id": "62e372b4-a286-5ca4-b55c-fa5bf689ba3f"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ]
        }
      },
      "name": "Job failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "id": "0cc7efa0-cd1f-56c5-8a36-41347ab73c08"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.AGRIINTEL_ALERT_FROM }}",
        "toEmail": "={{ $env.AGRIINTEL_ALERT_TO }}",
        "subject": "[AgriIntel] weekly_report failed",
        "emailFormat": "text",
        "text": "={{ JSON.stringify($json, null, 2) }}"
      },
      "name": "Alert platform admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        -100
      ],
      "credentials": {
        "smtp": {
          "id": "agriintel-smtp",
          "name": "AgriIntel SMTP"
        }
      },
      "id": "dd51c942-3805-509c-8c84-f3e2f0d53ada"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Run AgriIntel job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run AgriIntel job": {
      "main": [
        [
          {
            "node": "Job failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job failed?": {
      "main": [
        [
          {
            "node": "Alert platform admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "AgriIntel 08 - Failure alerts"
  },
  "meta": {
    "description": "Emails each organization admin a weekly summary. Idempotent per ISO week."
  },
  "tags": [
    {
      "name": "agriintel"
    }
  ]
}
