{
  "name": "AgriIntel 05 - Agricultural risk alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "29 9 * * *"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "008edae2-5289-5435-8442-524095145fa5"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGRIINTEL_API_URL }}/automation/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"kind\": \"risk_alerts\", \"params\": {\"threshold_pct\": -40, \"days\": 30}, \"idempotency_key\": \"risk-{{ $now.setZone('Asia/Colombo').toFormat('yyyy-LL-dd') }}\", \"wait\": true}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Run AgriIntel job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "agriintel-automation-key",
          "name": "AgriIntel automation key (X-Automation-Key)"
        }
      },
      "id": "60554ec9-b9d5-5426-825d-aa84691554b6"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ]
        }
      },
      "name": "Job failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "id": "ec0ab5cf-b81b-5a0c-9993-84c7b09cf38d"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.AGRIINTEL_ALERT_FROM }}",
        "toEmail": "={{ $env.AGRIINTEL_ALERT_TO }}",
        "subject": "[AgriIntel] risk_alerts failed",
        "emailFormat": "text",
        "text": "={{ JSON.stringify($json, null, 2) }}"
      },
      "name": "Alert platform admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        -100
      ],
      "credentials": {
        "smtp": {
          "id": "agriintel-smtp",
          "name": "AgriIntel SMTP"
        }
      },
      "id": "7b99af14-2d63-50f9-94ed-5ac94eb677cd"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Run AgriIntel job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run AgriIntel job": {
      "main": [
        [
          {
            "node": "Job failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job failed?": {
      "main": [
        [
          {
            "node": "Alert platform admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "AgriIntel 08 - Failure alerts"
  },
  "meta": {
    "description": "Creates deduplicated in-app alerts for orgs with farms in districts whose 30-day rainfall is 40% or more below normal."
  },
  "tags": [
    {
      "name": "agriintel"
    }
  ]
}
