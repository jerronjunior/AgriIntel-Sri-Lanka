# ---- API (FastAPI) --------------------------------------------------------
ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32+chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Development only: return verification / reset / invite tokens in API responses (never in production)
EMAIL_DEV_ECHO=true

# Database: API connects as restricted role agri_app (created by migration 0002, password from APP_DB_PASSWORD)
POSTGRES_PASSWORD=agri
APP_DB_PASSWORD=agri_app
DATABASE_URL=postgresql+psycopg://agri_app:agri_app@localhost:5432/agriintel
MIGRATION_DATABASE_URL=postgresql+psycopg://agri:agri@localhost:5432/agriintel
REDIS_URL=redis://localhost:6379/0

# Platform super admin created by the seed step
SUPERADMIN_EMAIL=admin@agriintel.local
SUPERADMIN_PASSWORD=ChangeMe12345

# SMTP (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AgriIntel <no-reply@agriintel.local>

# ---- Earth observation (server-side only) ---------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
# Earthdata Login user token (https://urs.earthdata.nasa.gov/ -> Generate Token). Needed for GPM IMERG / SMAP downloads.
EARTHDATA_TOKEN=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
# Sentinel-2 via Copernicus Data Space Ecosystem (not yet wired; see docs/continuation.md)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ---- n8n automation --------------------------------------------------------
# Shared secret n8n sends as X-Automation-Key. Store it in an n8n Header Auth credential, never in the web app.
AUTOMATION_API_KEY=
AGRIINTEL_MARKET_CSV_URL=

# ---- Optional LLM assistant (server-side only, not yet implemented) --------
LLM_API_KEY=

# ---- Web (Next.js) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin verification (API server)
FIREBASE_PROJECT_ID=

# NASA Data Kit browser source. Leave empty to use /data/sri_lanka_nasa.json,
# or set to the URL of `python -m nasa_kit serve` (for example http://127.0.0.1:8090).
NEXT_PUBLIC_NASA_KIT_URL=
